#!/bin/bash

# Optimized checkpac - Fast parallel package checker for Arch Linux
# Made by zeroz/tj - Optimized version with fast AUR batch checking

# Dependencies: expac, curl, jq
# Optional: pacman-contrib (for paccache)

# Set safer bash options
set -o pipefail

# Terminal colors
readonly COL_RESET="\e[0m"
readonly COL_BOLD="\e[1m"
readonly COL_RED="\e[31m"
readonly COL_GREEN="\e[32m"
readonly COL_YELLOW="\e[33m"
readonly COL_BLUE="\e[34m"
readonly COL_CYAN="\e[36m"
readonly COL_MAGENTA="\e[35m"
readonly COL_DIM="\e[2m"
readonly COL_HIGHLIGHT="\e[94m"

# Unicode symbols
readonly CHECK_MARK=$'\u2714'
readonly X_MARK=$'\u2718'
readonly UP_ARROW=$'\u2191'
readonly WARNING=$'\u25B2'
readonly DIVIDER="────────────────────────────────────"

# Global settings
declare -g search_desc=false
declare -g exclude_aur=false
declare -g exclude_arch=false
declare -g exact_match=false
declare -g check_remote=false
declare -g simple_mode=false
declare -g current_time=""
declare -ga search_terms=()

# Data caches - populated once
declare -gA installed_versions
declare -gA official_versions
declare -gA official_repos
declare -gA official_descriptions
declare -gA official_build_dates
declare -gA aur_installed
declare -gA aur_remote_versions  # Cache for AUR remote metadata
declare -gA aur_last_modified
declare -gA aur_popularity
declare -gA aur_votes
declare -gA aur_queried_packages  # Track which packages we actually queried AUR for

# Cleanup handler
cleanup() {
    trap - SIGINT SIGTERM EXIT
    pkill -P $$ 2>/dev/null || true
    exit 0
}

# Get repo color
get_repo_color() {
    local value
    case "$1" in
        core) value="${COL_RED}core${COL_RESET}" ;;
        extra) value="${COL_GREEN}extra${COL_RESET}" ;;
        multilib) value="${COL_CYAN}multilib${COL_RESET}" ;;
        *) value="${COL_MAGENTA}$1${COL_RESET}" ;;
    esac

    if [ -n "${2:-}" ]; then
        printf -v "$2" '%b' "$value"
    else
        echo -e "$value"
    fi
}

# Fast version comparison
version_differs() {
    [[ "$1" != "$2" ]]
}

# Turn a Unix timestamp into a compact, human-readable age.
format_age() {
    local timestamp=$1
    local output_var=${2:-}
    local now=${CHECKPAC_NOW:-${current_time:-$(date +%s)}}

    [[ "$timestamp" =~ ^[0-9]+$ && "$now" =~ ^[0-9]+$ ]] || return 1
    [ "$timestamp" -gt 0 ] || return 1

    local elapsed=$((now - timestamp))
    [ "$elapsed" -gt 0 ] || {
        if [ -n "$output_var" ]; then
            printf -v "$output_var" '%s' "just now"
        else
            echo "just now"
        fi
        return
    }

    local value unit result
    if [ "$elapsed" -lt 60 ]; then
        if [ -n "$output_var" ]; then
            printf -v "$output_var" '%s' "just now"
        else
            echo "just now"
        fi
        return
    elif [ "$elapsed" -lt 3600 ]; then
        value=$((elapsed / 60))
        unit="minute"
    elif [ "$elapsed" -lt 86400 ]; then
        value=$((elapsed / 3600))
        unit="hour"
    elif [ "$elapsed" -lt 604800 ]; then
        value=$((elapsed / 86400))
        unit="day"
    elif [ "$elapsed" -lt 2629800 ]; then
        value=$((elapsed / 604800))
        unit="week"
    elif [ "$elapsed" -lt 31557600 ]; then
        value=$((elapsed / 2629800))
        unit="month"
    else
        value=$((elapsed / 31557600))
        unit="year"
    fi

    [ "$value" -ne 1 ] && unit="${unit}s"
    result="$value $unit ago"
    if [ -n "$output_var" ]; then
        printf -v "$output_var" '%s' "$result"
    else
        echo "$result"
    fi
}

# Add freshness without consuming another terminal line.
display_update_age() {
    local age
    format_age "$1" age || return
    echo -ne " ${COL_DIM}· Updated $age${COL_RESET}"
}

# Exact names sort first, followed by prefix matches, then other matches.
package_relevance() {
    local name=${1,,}
    local output_var=${2:-}
    local term
    local result=2

    for term in "${search_terms[@]}"; do
        [ "$name" = "${term,,}" ] && {
            result=0
            break
        }
    done

    if [ "$result" -ne 0 ]; then
        for term in "${search_terms[@]}"; do
            [[ "$name" == "${term,,}"* ]] && {
                result=1
                break
            }
        done
    fi

    if [ -n "$output_var" ]; then
        printf -v "$output_var" '%s' "$result"
    else
        echo "$result"
    fi
}

sort_package_names_by_relevance() {
    local name relevance
    for name in "$@"; do
        package_relevance "$name" relevance
        printf '%s\t%s\n' "$relevance" "$name"
    done | LC_ALL=C sort -t $'\t' -k1,1n -k2,2 | cut -f2-
}

sort_aur_package_names() {
    local name relevance
    for name in "$@"; do
        package_relevance "$name" relevance
        printf '%s\t%s\t%s\t%s\n' \
            "$relevance" \
            "${aur_popularity[$name]:-0}" \
            "${aur_votes[$name]:-0}" \
            "$name"
    done | LC_ALL=C sort -t $'\t' -k1,1n -k2,2gr -k3,3nr -k4,4 | cut -f4-
}

# Highlight the changed portion of a new version
# Usage: highlight_version_diff "old_ver" "new_ver"
# Returns the new version with changed parts highlighted in green
highlight_version_diff() {
    local old_ver="$1"
    local new_ver="$2"
    
    # Find common prefix length
    local i=0
    local max_len=${#old_ver}
    [[ ${#new_ver} -lt $max_len ]] && max_len=${#new_ver}
    
    while [[ $i -lt $max_len ]] && [[ "${old_ver:$i:1}" == "${new_ver:$i:1}" ]]; do
        ((i++))
    done
    
    # Back up to last separator (., -, _) for cleaner highlighting
    while [[ $i -gt 0 ]] && [[ ! "${new_ver:$i-1:1}" =~ [.\-_] ]]; do
        ((i--))
    done
    
    # If no common prefix or diverged at start, highlight entire new version
    if [[ $i -eq 0 ]]; then
        echo -e "${COL_GREEN}$new_ver${COL_RESET}"
    else
        # Print common prefix dim, changed part in green
        echo -e "${COL_DIM}${new_ver:0:$i}${COL_RESET}${COL_GREEN}${new_ver:$i}${COL_RESET}"
    fi
}

# Populate all caches in single passes
populate_caches() {
    # Get all installed packages with versions
    while IFS=' ' read -r pkg ver; do
        installed_versions[$pkg]=$ver
    done < <(pacman -Q)
    
    # Get AUR packages
    while IFS=' ' read -r pkg ver; do
        aur_installed[$pkg]=$ver
    done < <(pacman -Qm)
    
    # Get official repo data in one expac call
    if command -v expac &>/dev/null; then
        while IFS=$'\t' read -r name ver repo build_date desc; do
            official_versions[$name]=$ver
            official_repos[$name]=$repo
            official_build_dates[$name]=$build_date
            official_descriptions[$name]=$desc
        done < <(expac -S --timefmt=%s '%n\t%v\t%r\t%b\t%d' 2>/dev/null)
    fi
}

# Match package against search terms
matches_search() {
    local pkg=$1
    local desc="${2:-}"
    
    if [ ${#search_terms[@]} -eq 0 ]; then
        return 0
    fi
    
    for term in "${search_terms[@]}"; do
        if [ "$exact_match" = true ]; then
            [[ "${pkg,,}" == "${term,,}" ]] && return 0
        else
            if [[ "${pkg,,}" == *"${term,,}"* ]]; then
                return 0
            elif [ "$search_desc" = true ] && [[ "${desc,,}" == *"${term,,}"* ]]; then
                return 0
            fi
        fi
    done
    return 1
}

# Display installed package
display_installed_pkg() {
    local pkg=$1
    
    # Simple mode - just the name
    if [ "$simple_mode" = true ]; then
        echo "$pkg"
        return
    fi
    
    local current_ver="${installed_versions[$pkg]}"
    local remote_ver="${official_versions[$pkg]}"
    local repo="${official_repos[$pkg]}"
    local desc="${official_descriptions[$pkg]}"
    local repo_color
    get_repo_color "$repo" repo_color
    
    echo -e "${COL_GREEN}$CHECK_MARK $pkg${COL_RESET} ${COL_CYAN}(v$current_ver)${COL_RESET}"
    
    [ -n "$desc" ] && echo -e "${COL_DIM}$desc${COL_RESET}"
    
    echo -ne "${COL_BLUE}└─ Source: Official [$repo_color]"
    
    if [ -z "$remote_ver" ]; then
        echo -ne " ${COL_YELLOW}$WARNING Unable to check${COL_RESET}"
    elif version_differs "$current_ver" "$remote_ver"; then
        echo -ne " ${COL_YELLOW}$UP_ARROW Update: v$current_ver${COL_RESET} → v$(highlight_version_diff "$current_ver" "$remote_ver")"
    else
        echo -ne " ${COL_GREEN}$CHECK_MARK Up to date${COL_RESET}"
    fi
    display_update_age "${official_build_dates[$pkg]}"
    echo
    echo
}

# Batch fetch all AUR versions at once
fetch_all_aur_versions() {
    local -a packages=("$@")
    [ ${#packages[@]} -eq 0 ] && return
    
    # Build one URL for all packages.
    local url="https://aur.archlinux.org/rpc/v5/info"
    local first=true
    
    for pkg in "${packages[@]}"; do
        # Preserve the existing offline behavior for foreign packages.
        aur_queried_packages[$pkg]=1

        if [ "$first" = true ]; then
            url="${url}?arg[]=$(echo -n "$pkg" | jq -sRr @uri)"
            first=false
        else
            url="${url}&arg[]=$(echo -n "$pkg" | jq -sRr @uri)"
        fi
    done
    
    # Fetch all metadata in one request
    local response=$(curl -fsSL --connect-timeout 2 --max-time 5 "$url" 2>/dev/null)

    if [ -n "$response" ] && echo "$response" | jq -e '.type == "multiinfo"' &>/dev/null; then
        while IFS=$'\x1f' read -r name version last_modified popularity votes; do
            [ -z "$name" ] && continue
            aur_remote_versions[$name]=$version
            aur_last_modified[$name]=$last_modified
            aur_popularity[$name]=$popularity
            aur_votes[$name]=$votes
        done < <(echo "$response" | jq -r '.results[] | [
            .Name,
            .Version,
            (.LastModified // 0),
            (.Popularity // 0),
            (.NumVotes // 0)
        ] | join("\u001f")' 2>/dev/null)
    fi
}

# Append AUR freshness and popularity to an existing source/status line.
display_aur_metadata() {
    local pkg=$1
    [ -n "${aur_last_modified[$pkg]}" ] || return

    local popularity=${aur_popularity[$pkg]:-0}
    local votes=${aur_votes[$pkg]:-0}
    local vote_label="votes"
    local formatted_popularity

    [ "$votes" -eq 1 ] && vote_label="vote"
    LC_NUMERIC=C printf -v formatted_popularity '%.2f' "$popularity"
    if [ "$formatted_popularity" = "0.00" ] && [ "$popularity" != "0" ]; then
        formatted_popularity="<0.01"
    fi

    display_update_age "${aur_last_modified[$pkg]}"
    echo -ne " ${COL_DIM}· $votes $vote_label · Pop. $formatted_popularity${COL_RESET}"
}

# Display AUR package (now uses pre-fetched versions)
display_aur_pkg() {
    local pkg=$1
    
    # Simple mode - just the name
    if [ "$simple_mode" = true ]; then
        echo "$pkg"
        return
    fi
    
    local ver="${aur_installed[$pkg]}"
    local desc=""
    
    # Get description if available
    if command -v expac &>/dev/null; then
        desc=$(expac -Q '%d' "$pkg" 2>/dev/null)
    fi
    
    echo -e "${COL_GREEN}$CHECK_MARK $pkg${COL_RESET} ${COL_CYAN}(v$ver)${COL_RESET}"
    [ -n "$desc" ] && echo -e "${COL_DIM}$desc${COL_RESET}"
    
    # Determine package type:
    # - VCS packages (-git, -svn, etc): "devel"
    # - Queried but not found in AUR: "local" 
    # - Found in AUR: "aur"
    local is_vcs=false
    local is_local=false
    
    if [[ "$pkg" =~ -(git|svn|hg|bzr)$ ]]; then
        is_vcs=true
    elif [[ -n "${aur_queried_packages[$pkg]}" && -z "${aur_remote_versions[$pkg]}" ]]; then
        # We queried AUR for this package but it wasn't in the results
        is_local=true
    fi
    
    # Display based on type
    if [ "$is_local" = true ]; then
        echo -ne "${COL_MAGENTA}└─ Source: Local [${COL_CYAN}local${COL_RESET}${COL_MAGENTA}]"
        echo -e " ${COL_DIM}(not tracked in AUR)${COL_RESET}"
    elif [ "$is_vcs" = true ]; then
        echo -ne "${COL_YELLOW}└─ Source: AUR [${COL_CYAN}devel${COL_RESET}${COL_YELLOW}]"
        echo -ne " ${COL_DIM}(VCS package - always latest)${COL_RESET}"
        display_aur_metadata "$pkg"
        echo
    else
        echo -ne "${COL_YELLOW}└─ Source: AUR [${COL_CYAN}aur${COL_RESET}${COL_YELLOW}]${COL_RESET}"
        
        local remote_ver="${aur_remote_versions[$pkg]}"
        
        if [ -z "$remote_ver" ]; then
            echo -ne " ${COL_YELLOW}$WARNING Unable to check${COL_RESET}"
        elif version_differs "$ver" "$remote_ver"; then
            echo -ne " ${COL_YELLOW}$UP_ARROW Update: v$ver${COL_RESET} → v$(highlight_version_diff "$ver" "$remote_ver")"
        else
            echo -ne " ${COL_GREEN}$CHECK_MARK Up to date${COL_RESET}"
        fi
        display_aur_metadata "$pkg"
        echo
    fi
    
    echo
}

# Display remote package
display_remote_pkg() {
    local pkg=$1
    
    # Simple mode - just the name
    if [ "$simple_mode" = true ]; then
        echo "$pkg"
        return
    fi
    
    local ver="${official_versions[$pkg]}"
    local repo="${official_repos[$pkg]}"
    local desc="${official_descriptions[$pkg]}"
    local repo_color
    get_repo_color "$repo" repo_color
    
    echo -e "${COL_RED}$X_MARK $pkg${COL_RESET} ${COL_CYAN}(v$ver)${COL_RESET}"
    [ -n "$desc" ] && echo -e "${COL_DIM}$desc${COL_RESET}"
    echo -ne "${COL_BLUE}└─ Available in [$repo_color]${COL_RESET}"
    display_update_age "${official_build_dates[$pkg]}"
    echo
    echo
}

# Search AUR via RPC, then rank combined results by relevance and popularity.
search_aur_remote() {
    declare -A result_versions=()
    declare -A result_descriptions=()

    # Debug mode - uncomment to see API calls
    # local debug=true
    local debug=false
    local term by_field url response

    for term in "${search_terms[@]}"; do
        by_field="name"
        [ "$search_desc" = true ] && by_field="name-desc"

        url="https://aur.archlinux.org/rpc/v5/search/$(echo -n "$term" | jq -sRr @uri)?by=$by_field"
        [ "$debug" = true ] && echo "Debug: Searching AUR for: $term (field: $by_field)" >&2
        [ "$debug" = true ] && echo "Debug: URL: $url" >&2

        response=$(curl -fsSL --connect-timeout 2 --max-time 5 "$url" 2>/dev/null)
        [ "$debug" = true ] && echo "Debug: Response length: ${#response}" >&2
        [ -z "$response" ] && continue

        while IFS=$'\x1f' read -r name ver desc last_modified popularity votes; do
            [ -z "$name" ] && continue
            [ -n "${installed_versions[$name]}" ] && continue

            # The RPC search is fuzzy; exact mode still needs a client-side check.
            if [ "$exact_match" = true ] && [[ "${name,,}" != "${term,,}" ]]; then
                continue
            fi

            result_versions[$name]=$ver
            result_descriptions[$name]=$desc
            aur_last_modified[$name]=$last_modified
            aur_popularity[$name]=$popularity
            aur_votes[$name]=$votes
        done < <(echo "$response" | jq -r '.results[]? | [
            .Name,
            .Version,
            (.Description // ""),
            (.LastModified // 0),
            (.Popularity // 0),
            (.NumVotes // 0)
        ] | join("\u001f")' 2>/dev/null)
    done

    local -a sorted_results=()
    if [ ${#result_versions[@]} -gt 0 ]; then
        mapfile -t sorted_results < <(
            sort_aur_package_names "${!result_versions[@]}"
        )
    fi

    local name ver desc pkg_type
    for name in "${sorted_results[@]}"; do
        if [ "$simple_mode" = true ]; then
            echo "$name"
            continue
        fi

        ver=${result_versions[$name]}
        desc=${result_descriptions[$name]}
        pkg_type="aur"
        [[ "$name" =~ -(git|svn|hg|bzr)$ ]] && pkg_type="devel"

        echo -e "${COL_RED}$X_MARK $name${COL_RESET} ${COL_CYAN}(v$ver)${COL_RESET}"
        [ -n "$desc" ] && echo -e "${COL_DIM}$desc${COL_RESET}"
        echo -ne "${COL_YELLOW}└─ Available in AUR [${COL_CYAN}$pkg_type${COL_RESET}${COL_YELLOW}]${COL_RESET}"
        display_aur_metadata "$name"
        echo
        echo
    done

    # Don't show "not found" message in simple mode
    if [ ${#sorted_results[@]} -eq 0 ] && [ "$simple_mode" = false ]; then
        echo -e "${COL_RED}$X_MARK No packages found in AUR${COL_RESET}\n"
    fi
}

# Show help
show_help() {
    cat <<EOF
checkpac - Fast package checker for Arch Linux

Usage: checkpac [options] <search-terms...>

Options:
    -h, --help          Show this help message
    -r, --remote        Include remote packages in search
    -d, --desc          Search package descriptions
    -e, --exact         Match package names exactly
    -s, --simple        Simple output (package names only, one per line)
    --exclude-aur       Exclude AUR packages
    --exclude-arch      Exclude official packages

Examples:
    checkpac python              # Search installed for "python"
    checkpac -r node             # Include remote packages
    checkpac -d compression      # Search descriptions
    checkpac -e wine             # Exact match only
    checkpac -s lib              # Simple output (names only)
    checkpac -rs python          # Remote search, simple output
EOF
}

# Main function
main() {
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -r|--remote)
                check_remote=true
                shift
                ;;
            -d|--desc)
                search_desc=true
                shift
                ;;
            -e|--exact)
                exact_match=true
                search_desc=false
                shift
                ;;
            -s|--simple)
                simple_mode=true
                shift
                ;;
            --exclude-aur)
                exclude_aur=true
                shift
                ;;
            --exclude-arch)
                exclude_arch=true
                shift
                ;;
            -*)
                # Handle combined flags like -rd, -rs, etc.
                if [[ "$1" =~ r ]]; then check_remote=true; fi
                if [[ "$1" =~ d ]]; then search_desc=true; fi
                if [[ "$1" =~ e ]]; then exact_match=true; search_desc=false; fi
                if [[ "$1" =~ s ]]; then simple_mode=true; fi
                shift
                ;;
            *)
                search_terms+=("$1")
                shift
                ;;
        esac
    done
    
    # Show help if no search terms
    if [ ${#search_terms[@]} -eq 0 ]; then
        show_help
        exit 1
    fi
    
    # Don't show header in simple mode
    if [ "$simple_mode" = false ]; then
        echo -e "${COL_BOLD}Searching for: ${search_terms[*]}${COL_RESET}\n"
    fi
    
    # Populate all caches upfront
    populate_caches
    current_time=$(date +%s)

    local -a sorted_installed_packages=()
    mapfile -t sorted_installed_packages < <(
        printf '%s\n' "${!installed_versions[@]}" | LC_ALL=C sort
    )
    
    # Process installed official packages
    if [ "$exclude_arch" = false ]; then
        local found_official=false
        
        for pkg in "${sorted_installed_packages[@]}"; do
            # Skip AUR packages
            [ -n "${aur_installed[$pkg]}" ] && continue
            
            # Check if matches search
            local desc="${official_descriptions[$pkg]}"
            matches_search "$pkg" "$desc" || continue
            
            if [ "$found_official" = false ]; then
                if [ "$simple_mode" = false ]; then
                    echo -e "${COL_BLUE}$DIVIDER${COL_RESET}"
                    echo -e "${COL_BOLD}${COL_CYAN}Official Repositories Installed:${COL_RESET}"
                    echo -e "${COL_BLUE}$DIVIDER${COL_RESET}"
                fi
                found_official=true
            fi
            
            display_installed_pkg "$pkg"
        done
        
        if [ "$found_official" = false ] && [ "$exclude_aur" = true ] && [ "$simple_mode" = false ]; then
            echo -e "${COL_RED}$X_MARK No installed packages found${COL_RESET}\n"
        fi
    fi
    
    # Process installed AUR packages
    if [ "$exclude_aur" = false ]; then
        local found_aur=false
        declare -a matching_aur_packages=()
        
        # First, collect all matching AUR packages
        for pkg in "${!aur_installed[@]}"; do
            # Get description for matching
            local desc=""
            if [ "$search_desc" = true ] && command -v expac &>/dev/null; then
                desc=$(expac -Q '%d' "$pkg" 2>/dev/null)
            fi
            
            matches_search "$pkg" "$desc" || continue
            matching_aur_packages+=("$pkg")
        done
        
        # Batch fetch all AUR versions at once
        if [ ${#matching_aur_packages[@]} -gt 0 ]; then
            mapfile -t matching_aur_packages < <(
                printf '%s\n' "${matching_aur_packages[@]}" | LC_ALL=C sort
            )
            fetch_all_aur_versions "${matching_aur_packages[@]}"
            
            if [ "$simple_mode" = false ]; then
                echo -e "${COL_YELLOW}$DIVIDER${COL_RESET}"
                echo -e "${COL_BOLD}${COL_YELLOW}AUR/Local Installed:${COL_RESET}"
                echo -e "${COL_YELLOW}$DIVIDER${COL_RESET}"
            fi
            
            # Now display all matching packages
            for pkg in "${matching_aur_packages[@]}"; do
                display_aur_pkg "$pkg"
            done
        fi
    fi
    
    # Process remote packages if requested
    if [ "$check_remote" = true ]; then
        # Official remote packages
        if [ "$exclude_arch" = false ]; then
            local -a matching_official_packages=()
            
            for pkg in "${!official_versions[@]}"; do
                # Skip installed
                [ -n "${installed_versions[$pkg]}" ] && continue
                
                # Check match
                matches_search "$pkg" "${official_descriptions[$pkg]}" || continue
                matching_official_packages+=("$pkg")
            done

            if [ ${#matching_official_packages[@]} -gt 0 ]; then
                mapfile -t matching_official_packages < <(
                    sort_package_names_by_relevance "${matching_official_packages[@]}"
                )

                if [ "$simple_mode" = false ]; then
                    echo -e "${COL_BLUE}$DIVIDER${COL_RESET}"
                    echo -e "${COL_BOLD}${COL_BLUE}Official Repositories Available:${COL_RESET}"
                    echo -e "${COL_BLUE}$DIVIDER${COL_RESET}"
                fi

                for pkg in "${matching_official_packages[@]}"; do
                    display_remote_pkg "$pkg"
                done
            elif [ "$exclude_aur" = true ] && [ "$simple_mode" = false ]; then
                echo -e "${COL_RED}$X_MARK No remote packages found${COL_RESET}\n"
            fi
        fi
        
        # AUR remote packages
        if [ "$exclude_aur" = false ]; then
            if [ "$simple_mode" = false ]; then
                echo -e "${COL_YELLOW}$DIVIDER${COL_RESET}"
                echo -e "${COL_BOLD}${COL_YELLOW}AUR Available:${COL_RESET}"
                echo -e "${COL_YELLOW}$DIVIDER${COL_RESET}"
            fi
            
            search_aur_remote
        fi
    fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    trap cleanup SIGINT SIGTERM EXIT
    main "$@"
fi
